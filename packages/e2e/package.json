{
  "name": "e2e",
  "version": "0.0.0-dev",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "prepare:fixtures": "node ./scripts/prepare-fixtures.mjs",
    "e2e": "npm run prepare:fixtures && test-with-playwright --only-extension=. --test-path=. --reuse-page",
    "e2e:firefox": "npm run prepare:fixtures && test-with-playwright --only-extension=. --test-path=. --browser=firefox --reuse-page",
    "e2e:firefox:headless": "npm run prepare:fixtures && test-with-playwright --only-extension=. --test-path=. --browser=firefox --headless --reuse-page",
    "e2e:headless": "npm run prepare:fixtures && test-with-playwright --only-extension=. --test-path=. --headless --reuse-page",
    "e2e:webkit": "npm run prepare:fixtures && test-with-playwright --only-extension=. --test-path=. --browser=webkit",
    "e2e:webkit:headless": "npm run prepare:fixtures && test-with-playwright --only-extension=. --test-path=. --browser=webkit --headless",
    "type-check": "tsc"
  },
  "devDependencies": {
    "@lvce-editor/api": "^9.53.1",
    "@lvce-editor/test-with-playwright": "^22.43.0",
    "@lvce-editor/rpc": "^6.23.0",
    "esbuild": "^0.28.2"
  }
}
